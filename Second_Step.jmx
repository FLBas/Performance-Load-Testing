              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="[JSR223_PreProcessor]_generateCities" enabled="true">
                <stringProp name="scriptLanguage">java</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">String[] cities = {&quot;Frankfurt&quot;, &quot;Denver&quot;, &quot;London&quot;, &quot;Los Angeles&quot;, &quot;Paris&quot;, &quot;Portland&quot;, &quot;San Francisco&quot;, &quot;Seattle&quot;, &quot;Sydney&quot;, &quot;Zurich&quot;};

Random rand = new Random();

String arrive = &quot;&quot;;
arrive = cities[rand.nextInt(cities.length)];

String depart = arrive;

while (arrive.equals(depart)) {
	depart = cities[rand.nextInt(cities.length)];
}

vars.put(&quot;arrive&quot;, arrive);
vars.put(&quot;depart&quot;, depart);</stringProp>
              </JSR223PreProcessor>
